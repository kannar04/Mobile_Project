{
  "name": "anilove-foundation-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:adoption-domain": "node --test adoption-domain.test.mjs",
    "test:adoption-rules": "firebase emulators:exec --config ../firebase.feature-tests.json --project demo-anilove-feature-tests --only auth,firestore \"node --test adoption-batch.test.mjs\"",
    "test:feature-domain": "node --test f09-f30-domain.test.mjs",
    "test:feature-rules": "firebase emulators:exec --config ../firebase.feature-tests.json --project demo-anilove-feature-tests --only auth,firestore,storage \"node --test f09-f30-rules.test.mjs\"",
    "seed:demo": "node seed-demo.mjs",
    "test": "firebase emulators:exec --config ../firebase.json --project demo-anilove --only auth,firestore \"node --test --test-concurrency=1 foundation.test.mjs profile.test.mjs pet.test.mjs listing.test.mjs community.test.mjs daily.test.mjs\"",
    "test:placement-domain": "node --test placement-domain.test.mjs",
    "test:placement-rules": "firebase emulators:exec --config ../firebase.feature-tests.json --project demo-anilove-feature-tests --only auth,firestore \"node --test placement-rules.test.mjs\"",
    "test:safety-domain": "node --test safety-domain.test.mjs",
    "test:safety-rules": "firebase emulators:exec --config ../firebase.feature-tests.json --project demo-anilove-feature-tests --only auth,firestore \"node --test safety-rules.test.mjs\"",
    "test:extensions-domain": "node --test extensions-domain.test.mjs",
    "test:extensions-rules": "firebase emulators:exec --config ../firebase.feature-tests.json --project demo-anilove-feature-tests --only auth,firestore \"node --test extensions-rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.14.0",
    "firebase-tools": "15.33.0",
    "sharp": "0.35.5"
  }
}
