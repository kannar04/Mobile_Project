      allow create,update: if request.auth!=null && rollout() && sfeed(request.resource.data,id) && srootLink(id,request.auth.uid,getAfter(/databases/$(database)/documents/communityPosts/$(id)).data.lastOperationId)
        && sproject(id,getAfter(/databases/$(database)/documents/communityPosts/$(id)).data);
      allow delete: if request.auth!=null && srootLink(id,request.auth.uid,getAfter(/databases/$(database)/documents/communityPosts/$(id)).data.lastOperationId)
        && getAfter(/databases/$(database)/documents/communityPosts/$(id)).data.visibility=='hidden';
    }
    function parentVisibleAfter(id){return existsAfter(/databases/$(database)/documents/communityFeed/$(id)) && getAfter(/databases/$(database)/documents/communityFeed/$(id)).data.schemaVersion==2 && getAfter(/databases/$(database)/documents/communityFeed/$(id)).data.state=='visible';}
    function parentVisible(id){return exists(/databases/$(database)/documents/communityFeed/$(id)) && get(/databases/$(database)/documents/communityFeed/$(id)).data.schemaVersion==2 && get(/databases/$(database)/documents/communityFeed/$(id)).data.state=='visible';}
    function scount(d,id){return d.keys().size()==6 && d.keys().hasOnly(['schemaVersion','postId','likeCount','countVersion','updatedAt','lastOperationId']) && d.schemaVersion is int && d.schemaVersion==2 && d.postId==id && d.likeCount is int && d.likeCount>=0 && d.countVersion is int && d.countVersion>=0 && d.updatedAt==request.time && validId(d.lastOperationId);}
    function slike(d,id,uid){return d.keys().size()==8 && d.keys().hasOnly(['schemaVersion','uid','postId','active','likeVersion','sourceContentVersion','updatedAt','lastOperationId']) && d.schemaVersion is int && d.schemaVersion==2 && d.uid==uid && d.postId==id && d.active is bool && d.likeVersion is int && d.likeVersion>=1 && d.sourceContentVersion is int && d.sourceContentVersion>=1 && d.updatedAt==request.time && validId(d.lastOperationId);}
    function likeDelta(id,uid,op){
      let path=/databases/$(database)/documents/communityPosts/$(id)/likes/$(uid);
      let n=getAfter(path).data;
      let oldActive=exists(path)?get(path).data.active:false;
      let oldVersion=exists(path)?get(path).data.likeVersion:0;
      let count=get(/databases/$(database)/documents/communityCounts/$(id)).data;
      let next=getAfter(/databases/$(database)/documents/communityCounts/$(id)).data;
      let r=sop(uid,op);
      return self(uid) && slike(n,id,uid) && scount(next,id) && n.lastOperationId==op && next.lastOperationId==op
        && n.active!=oldActive && n.likeVersion==oldVersion+1 && r.command=='set_like' && r.postId==id && r.targetId==null
        && r.base.targetVersion==oldVersion && r.result=={'targetVersion':n.likeVersion} && r.input=={'active':n.active} && r.committedAt==request.time
        && next.likeCount==count.likeCount+(n.active?1:-1) && next.countVersion==count.countVersion+1
        && (n.active ? basicMemberReady(uid) && parentVisibleAfter(id) && n.sourceContentVersion==get(/databases/$(database)/documents/communityFeed/$(id)).data.contentVersion && r.base.contentVersion==n.sourceContentVersion : oldActive && n.sourceContentVersion==(parentVisible(id)?get(/databases/$(database)/documents/communityFeed/$(id)).data.contentVersion:get(path).data.sourceContentVersion));
    }
    function likeNoop(r,uid){
      let p=/databases/$(database)/documents/communityPosts/$(r.postId)/likes/$(uid);
      return r.command=='set_like' && r.targetId==null && r.input.keys().size()==1 && r.input.active is bool
        && r.base.targetVersion==(exists(p)?get(p).data.likeVersion:0) && r.result=={'targetVersion':r.base.targetVersion}
        && r.input.active==(exists(p)?get(p).data.active:false) && (r.input.active ? basicMemberReady(uid) && parentVisible(r.postId) : true);
    }
    match /communityPosts/{id}/likes/{uid} {
      allow get: if self(uid);allow list,delete: if false;
      allow create,update: if self(uid) && likeDelta(id,uid,request.resource.data.lastOperationId);
    }
    match /communityCounts/{id} {
      allow get: if request.auth!=null && (!exists(/databases/$(database)/documents/communityCounts/$(id)) || parentVisible(id) || get(/databases/$(database)/documents/communityPosts/$(id)/likes/$(request.auth.uid)).data.active==true || communityOwner(id));
      allow create: if request.auth!=null && scount(request.resource.data,id) && request.resource.data.likeCount==0 && request.resource.data.countVersion==0
        && srootLink(id,request.auth.uid,request.resource.data.lastOperationId) && getAfter(/databases/$(database)/documents/communityPosts/$(id)).data.visibility=='visible';
      allow update: if request.auth!=null && likeDelta(id,request.auth.uid,request.resource.data.lastOperationId);
      allow list,delete: if false;
    }
    function commentShape(c,id){return c.keys().size()==11 && c.keys().hasOnly(['schemaVersion','postId','authorUid','sourceContentVersion','commentVersion','body','state','createdAt','editedAt','updatedAt','operationId']) && c.schemaVersion is int && c.schemaVersion==2 && c.postId==id && c.authorUid is string
      && c.sourceContentVersion is int && c.sourceContentVersion>=1 && c.commentVersion is int && c.commentVersion>=1 && unicodeBound(c.body,1,500,2000) && c.body==c.body.trim() && c.state in ['visible','withdrawn'] && c.createdAt is timestamp && (c.editedAt==null || c.editedAt is timestamp) && c.updatedAt==request.time && validId(c.operationId);}
    function commentLink(id,cid,uid,op){
      let path=/databases/$(database)/documents/communityPosts/$(id)/comments/$(cid);
      let n=getAfter(path).data;
      let r=sop(uid,op);
      let v=getAfter(/databases/$(database)/documents/communityPosts/$(id)/comments/$(cid)/revisions/$('v'+string(n.commentVersion))).data;
      let f=getAfter(/databases/$(database)/documents/communityCommentFeed/$(id)/comments/$(cid)).data;
      return self(uid) && validId(cid) && commentShape(n,id) && n.authorUid==uid && n.operationId==op && r.postId==id && r.targetId==cid && r.committedAt==request.time
        && r.base.targetVersion==(exists(path)?get(path).data.commentVersion:0) && n.commentVersion==r.base.targetVersion+1 && r.result=={'targetVersion':n.commentVersion}
        && (exists(path)?get(path).data.authorUid==uid && get(path).data.state=='visible' && n.createdAt==get(path).data.createdAt && n.editedAt==request.time:r.command=='add_comment' && n.createdAt==request.time && n.editedAt==null)
        && v=={'schemaVersion':2,'postId':id,'commentId':cid,'authorUid':uid,'commentVersion':n.commentVersion,'sourceContentVersion':n.sourceContentVersion,'body':n.body,'state':n.state,'createdAt':request.time,'operationId':op}
        && (r.command=='withdraw_comment'? n.state=='withdrawn' && r.input=={} && n.body==get(path).data.body && n.sourceContentVersion==get(path).data.sourceContentVersion && !existsAfter(/databases/$(database)/documents/communityCommentFeed/$(id)/comments/$(cid))
          : r.command in ['add_comment','edit_comment'] && n.state=='visible' && r.input=={'body':n.body} && basicMemberReady(uid) && parentVisibleAfter(id) && n.sourceContentVersion==r.base.contentVersion && n.sourceContentVersion==get(/databases/$(database)/documents/communityFeed/$(id)).data.contentVersion
          && f=={'schemaVersion':2,'postId':id,'commentId':cid,'authorUid':uid,'commentVersion':n.commentVersion,'sourceContentVersion':n.sourceContentVersion,'body':n.body,'state':'visible','createdAt':n.createdAt,'editedAt':n.editedAt});
    }
    match /communityPosts/{id}/comments/{cid} {
      allow get: if request.auth!=null && (!exists(/databases/$(database)/documents/communityPosts/$(id)/comments/$(cid)) || resource.data.authorUid==request.auth.uid);
      allow create,update: if request.auth!=null && commentLink(id,cid,request.auth.uid,request.resource.data.operationId);
      allow list,delete: if false;
      match /revisions/{v} {allow get: if request.auth!=null && get(/databases/$(database)/documents/communityPosts/$(id)/comments/$(cid)).data.authorUid==request.auth.uid;
        allow create: if request.auth!=null && v=='v'+string(request.resource.data.commentVersion) && commentLink(id,cid,request.auth.uid,request.resource.data.operationId);allow list,update,delete: if false;}
    }
    match /communityCommentFeed/{id}/comments/{cid} {
      allow get: if request.auth!=null && parentVisible(id) && resource.data.schemaVersion==2 && resource.data.state=='visible';
      allow list: if request.auth!=null && parentVisible(id) && page20() && resource.data.schemaVersion==2 && resource.data.state=='visible';
      allow create,update,delete: if request.auth!=null && commentLink(id,cid,request.auth.uid,getAfter(/databases/$(database)/documents/communityPosts/$(id)/comments/$(cid)).data.operationId);
    }
    match /users/{uid}/communityOperations/{op} {
      allow create: if self(uid) && sreceipt(request.resource.data,uid,op)
        && (request.resource.data.command=='set_like'?likeNoop(request.resource.data,uid) || likeDelta(request.resource.data.postId,uid,op)
          :request.resource.data.command in ['add_comment','edit_comment','withdraw_comment']?commentLink(request.resource.data.postId,request.resource.data.targetId,uid,op):srootLink(request.resource.data.postId,uid,op));
    }

    // F29 intake only. No client reviewer/status/hold capability.
    function reportPolicy(kind){
      let p=get(/databases/$(database)/documents/system/reportPolicy).data;
      return p.keys().size()==5 && p.keys().hasOnly(['schemaVersion','policyVersion','intakeEnabled','supportedTargetKinds','updatedAt'])
        && p.schemaVersion==1 && p.policyVersion is int && p.policyVersion>=1 && p.intakeEnabled==true && p.supportedTargetKinds is list
        && p.supportedTargetKinds.hasOnly(['post','comment']) && kind in p.supportedTargetKinds && p.updatedAt is timestamp;
    }
    match /system/reportPolicy {allow get: if request.auth!=null && (!exists(/databases/$(database)/documents/system/reportPolicy) || resource.data.keys().size()==5 && resource.data.keys().hasOnly(['schemaVersion','policyVersion','intakeEnabled','supportedTargetKinds','updatedAt']) && resource.data.schemaVersion is int && resource.data.schemaVersion==1 && resource.data.policyVersion is int && resource.data.policyVersion>=1 && resource.data.intakeEnabled is bool && resource.data.supportedTargetKinds is list && resource.data.supportedTargetKinds.hasOnly(['post','comment']) && resource.data.updatedAt is timestamp);allow list,write: if false;}
    function reportKey(r){return r.targetKind=='post'?'post_'+r.targetId:'comment_'+r.parentId+'_'+r.targetId;}
    function reportPayload(statement,evidence){return statement.toUtf8().size()+(evidence==null?0:evidence.toUtf8().size())<=6144;}
    function reportShape(r){return r.keys().size()==17 && r.keys().hasOnly(['schemaVersion','reporterUid','targetKind','targetId','parentId','observedVersion','category','statement','evidenceText','snapshotProvenance','sourceRef','status','statusVersion','createdAt','lastReporterVersion','opId','lastReporterOperationId'])
      && r.schemaVersion is int && r.schemaVersion==1 && r.reporterUid is string && r.targetKind in ['post','comment'] && validId(r.targetId)
      && (r.targetKind=='post'?r.parentId==null:validId(r.parentId)) && r.observedVersion is int && r.observedVersion>=1
      && r.category in ['spam','harassment','misleading_information','privacy','animal_welfare','other']
      && unicodeBound(r.statement,r.category=='other'?1:0,1000,4000) && (r.evidenceText==null || unicodeBound(r.evidenceText,1,1000,4000))
      && reportPayload(r.statement,r.evidenceText) && r.snapshotProvenance in ['current_authorized_projection','reporter_statement'] && (r.sourceRef==null || r.sourceRef is string)
      && r.status=='received' && r.statusVersion==1 && r.createdAt==request.time && r.lastReporterVersion==1 && validId(r.opId) && r.lastReporterOperationId==r.opId;}
    function reportOwn(id){return request.auth!=null && get(/databases/$(database)/documents/reports/$(id)).data.reporterUid==request.auth.uid;}
    function reportRevision(v,id,uid,n){return v.keys().size()==12 && v.keys().hasOnly(['schemaVersion','reportId','reporterUid','reporterVersion','command','statement','evidenceText','observedVersion','snapshotProvenance','sourceRef','operationId','createdAt'])
      && v.schemaVersion is int && v.schemaVersion==1 && v.reportId==id && v.reporterUid==uid && v.reporterVersion==n && v.command in ['submit','append','withdraw']
      && unicodeBound(v.statement,0,1000,4000) && (v.evidenceText==null || unicodeBound(v.evidenceText,1,1000,4000)) && v.observedVersion is int && v.observedVersion>=1
      && reportPayload(v.statement,v.evidenceText) && v.snapshotProvenance in ['current_authorized_projection','reporter_statement'] && (v.sourceRef==null || v.sourceRef is string) && validId(v.operationId) && v.createdAt==request.time;}
    function reportReceipt(o,uid,op){return o.keys().size()==10 && o.keys().hasOnly(['schemaVersion','ownerUid','operationId','command','reportId','targetKey','baseVersion','resultVersion','input','committedAt'])
      && o.schemaVersion is int && o.schemaVersion==1 && o.ownerUid==uid && o.operationId==op && validId(op) && validId(o.reportId) && o.command in ['submit','append','withdraw']
      && o.targetKey is string && o.baseVersion is int && o.baseVersion>=0 && o.resultVersion==o.baseVersion+1
      && o.input.keys().size()==4 && o.input.keys().hasOnly(['category','statement','evidenceText','observedVersion']) && o.input.category in ['spam','harassment','misleading_information','privacy','animal_welfare','other']
      && unicodeBound(o.input.statement,o.input.category=='other'?1:0,1000,4000) && (o.input.evidenceText==null || unicodeBound(o.input.evidenceText,1,1000,4000)) && reportPayload(o.input.statement,o.input.evidenceText) && o.input.observedVersion is int && o.input.observedVersion>=1 && o.committedAt==request.time;}
    function reportCommon(id,uid,op){
      let r=getAfter(/databases/$(database)/documents/reports/$(id)).data;
      let o=getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data;
      let v=getAfter(/databases/$(database)/documents/reports/$(id)/reporterRevisions/$('v'+string(r.lastReporterVersion))).data;
      return self(uid) && profileOwner(uid) && r.reporterUid==uid && r.lastReporterOperationId==op && o.reportId==id && o.targetKey==reportKey(r)
        && o.ownerUid==uid && o.operationId==op && o.committedAt==request.time && !exists(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op))
        && v.reporterVersion==r.lastReporterVersion && v.reporterUid==uid && v.createdAt==request.time && v.operationId==op && v.command==o.command && o.resultVersion==r.lastReporterVersion
        && v.statement==o.input.statement && v.evidenceText==o.input.evidenceText && v.observedVersion==o.input.observedVersion;
    }
    function reportRate(id,uid,op){
      let path=/databases/$(database)/documents/reportRateControls/$(uid);
      let n=getAfter(path).data;
      return n.keys().size()==6 && n.keys().hasOnly(['windowStart','count','lastAcceptedAt','version','lastReportId','lastOperationId'])
        && n.lastReportId==id && n.lastOperationId==op && n.lastAcceptedAt==request.time && n.count is int && n.count>=1 && n.count<=30 && n.version is int
        && (!exists(path)?n.version==1 && n.count==1 && n.windowStart==request.time
          : n.version==get(path).data.version+1
            && (n.count==get(path).data.count+1 && n.windowStart==get(path).data.windowStart
              || n.count==1 && n.windowStart==request.time && request.time>=get(path).data.windowStart+duration.value(24,'h')));
    }
    function reportRateWrite(uid){
      let n=request.resource.data;
      let o=getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(n.lastOperationId)).data;
      return self(uid)
        && getAfter(/databases/$(database)/documents/reports/$(n.lastReportId)).data.lastReporterOperationId==n.lastOperationId
        && o.ownerUid==uid && o.reportId==n.lastReportId && o.command!='withdraw' && o.committedAt==request.time;
    }
    function reportEvidence(id,uid,r){
      let e=getAfter(/databases/$(database)/documents/reports/$(id)/restrictedEvidence/current).data;
      let parent=r.parentId==null?r.targetId:r.parentId;
      let post=/databases/$(database)/documents/communityFeed/$(parent);
      let comment=/databases/$(database)/documents/communityCommentFeed/$(parent)/comments/$(r.targetId);
      return (e.body==null || e.body is string && e.body.toUtf8().size()<=3072) && e.keys().size()==7 && e.keys().hasOnly(['schemaVersion','reportId','reporterUid','provenance','sourceRef','observedVersion','body'])
        && e.schemaVersion is int && e.schemaVersion==1 && e.reportId==id && e.reporterUid==uid && e.provenance==r.snapshotProvenance && e.sourceRef==r.sourceRef && e.observedVersion==r.observedVersion
        && (e.provenance=='reporter_statement'?e.sourceRef==null && e.body==null
          : parentVisible(parent) && (r.targetKind=='post'? e.sourceRef=='communityFeed/'+r.targetId && e.body==get(post).data.body && e.observedVersion==get(post).data.contentVersion
            : e.sourceRef=='communityCommentFeed/'+parent+'/comments/'+r.targetId && get(comment).data.state=='visible' && e.body==get(comment).data.body && e.observedVersion==get(comment).data.commentVersion));
    }
    function reportProvenance(r,v){
      let parent=r.parentId==null?r.targetId:r.parentId;
      return v.snapshotProvenance=='reporter_statement'?v.sourceRef==null
        : parentVisible(parent) && (r.targetKind=='post'?v.sourceRef=='communityFeed/'+r.targetId && v.observedVersion==get(/databases/$(database)/documents/communityFeed/$(parent)).data.contentVersion
          : v.sourceRef=='communityCommentFeed/'+parent+'/comments/'+r.targetId && get(/databases/$(database)/documents/communityCommentFeed/$(parent)/comments/$(r.targetId)).data.state=='visible'
            && v.observedVersion==get(/databases/$(database)/documents/communityCommentFeed/$(parent)/comments/$(r.targetId)).data.commentVersion);
    }
    function reportInitial(id,uid,op){
      let r=getAfter(/databases/$(database)/documents/reports/$(id)).data;
      let link=getAfter(/databases/$(database)/documents/users/$(uid)/reportLinks/$(reportKey(r))).data;
      let status=getAfter(/databases/$(database)/documents/users/$(uid)/reportStatus/$(id)).data;
      return reportCommon(id,uid,op) && r.opId==op
        && r.statement==getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data.input.statement
        && r.category==getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data.input.category
        && r.evidenceText==getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data.input.evidenceText
        && r.observedVersion==getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data.input.observedVersion
        && reportShape(r) && reportPolicy(r.targetKind) && reportRate(id,uid,op) && getAfter(/databases/$(database)/documents/reports/$(id)/restrictedEvidence/current).data.reportId==id && getAfter(/databases/$(database)/documents/reports/$(id)/restrictedEvidence/current).data.reporterUid==uid
        && getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data.command=='submit'
        && getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data.baseVersion==0
        && !exists(/databases/$(database)/documents/users/$(uid)/reportLinks/$(reportKey(r)))
        && link=={'schemaVersion':1,'targetKind':r.targetKind,'parentId':r.parentId,'targetId':r.targetId,'currentReportId':id,'state':'open','updatedAt':request.time}
        && status=={'schemaVersion':1,'reportId':id,'targetKind':r.targetKind,'parentId':r.parentId,'targetId':r.targetId,'category':r.category,'status':'received','statusVersion':1,'response':null,'createdAt':request.time,'updatedAt':request.time};
    }
    function reportAppend(id,uid,op){
      let old=get(/databases/$(database)/documents/reports/$(id)).data;
      let n=getAfter(/databases/$(database)/documents/reports/$(id)).data;
      let o=getAfter(/databases/$(database)/documents/users/$(uid)/reportOperations/$(op)).data;
      return reportCommon(id,uid,op) && old.reporterUid==uid && n.diff(old).affectedKeys().hasOnly(['lastReporterVersion','lastReporterOperationId'])
        && n.lastReporterVersion==old.lastReporterVersion+1 && o.baseVersion==old.lastReporterVersion && o.input.category==old.category
        && (o.command=='withdraw' || o.command=='append' && reportPolicy(old.targetKind) && reportRate(id,uid,op));
    }
    function reportLinked(id,uid,op){return exists(/databases/$(database)/documents/reports/$(id))?reportAppend(id,uid,op):reportInitial(id,uid,op);}
    match /reports/{id} {
      allow get: if request.auth!=null && (!exists(/databases/$(database)/documents/reports/$(id)) || resource.data.reporterUid==request.auth.uid);
      allow create: if request.auth!=null && validId(id) && reportInitial(id,request.auth.uid,request.resource.data.opId);
      allow update: if request.auth!=null && reportAppend(id,request.auth.uid,request.resource.data.lastReporterOperationId);
      allow list,delete: if false;
      match /reporterRevisions/{v} {
        allow get: if reportOwn(id);allow list: if reportOwn(id) && page20();
        allow create: if request.auth!=null && v=='v'+string(request.resource.data.reporterVersion) && reportRevision(request.resource.data,id,request.auth.uid,request.resource.data.reporterVersion) && reportProvenance(getAfter(/databases/$(database)/documents/reports/$(id)).data,request.resource.data) && reportCommon(id,request.auth.uid,request.resource.data.operationId);
        allow update,delete: if false;
      }
      match /restrictedEvidence/current {allow get: if reportOwn(id);allow create: if request.auth!=null && reportCommon(id,request.auth.uid,getAfter(/databases/$(database)/documents/reports/$(id)).data.opId) && !exists(/databases/$(database)/documents/reports/$(id)) && reportEvidence(id,request.auth.uid,getAfter(/databases/$(database)/documents/reports/$(id)).data);allow list,update,delete: if false;}
    }
    match /users/{uid}/reportStatus/{id} {allow get: if self(uid);allow list: if self(uid) && page20();allow create: if self(uid) && reportCommon(id,uid,getAfter(/databases/$(database)/documents/reports/$(id)).data.opId) && !exists(/databases/$(database)/documents/reports/$(id));allow update,delete: if false;}
    match /users/{uid}/reportLinks/{key} {allow get: if self(uid);allow create: if self(uid) && key==reportKey(getAfter(/databases/$(database)/documents/reports/$(request.resource.data.currentReportId)).data) && reportCommon(request.resource.data.currentReportId,uid,getAfter(/databases/$(database)/documents/reports/$(request.resource.data.currentReportId)).data.opId) && !exists(/databases/$(database)/documents/reports/$(request.resource.data.currentReportId));allow list,update,delete: if false;}
    match /reportRateControls/{uid} {
      allow get: if self(uid);
      allow create,update: if reportRateWrite(uid);
      allow list,delete: if false;
    }
    match /users/{uid}/reportOperations/{op} {allow get: if self(uid);allow list: if self(uid) && page20();allow create: if self(uid) && reportReceipt(request.resource.data,uid,op) && reportCommon(request.resource.data.reportId,uid,op);allow update,delete: if false;}

    // F06_TEST_PROBE_ANCHOR: only the emulator test loader injects a temporary predicate probe.
    match /{document=**} { allow read, write: if false; }
  }
}
