<?xml version="1.0" encoding="utf-8" ?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/questionnaire_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anilove_bg"
    android:fillViewport="true"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
    >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
        >
            <com.google.android.material.button.MaterialButton
                android:id="@+id/questionnaire_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/auth_back"
                android:textColor="@color/anilove_text_dark"
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/questionnaire_title"
                android:textColor="@color/anilove_text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
            />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/anilove_card_bg"
            android:orientation="vertical"
            android:padding="20dp"
        >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bước 1/3: Thông tin Cơ bản"
                android:textColor="@color/anilove_primary"
                android:textSize="14sp"
                android:textStyle="bold"
            />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Kinh nghiệm nuôi thú cưng:"
                android:textColor="@color/anilove_text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
            />

            <RadioGroup
                android:id="@+id/rg_experience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
            >
                <RadioButton
                    android:id="@+id/rb_exp_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa từng nuôi"
                />

                <RadioButton
                    android:id="@+id/rb_exp_some"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Đã nuôi 1-2 năm"
                />

                <RadioButton
                    android:id="@+id/rb_exp_pro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhiều năm kinh nghiệm"
                />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Lý do bạn muốn nhận nuôi:"
                android:textColor="@color/anilove_text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
            />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AniLoveOutlinedField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Nhập lý do chi tiết..."
            >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_questionnaire_submit"
                style="@style/AniLovePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Gửi khảo sát phù hợp"
            />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
