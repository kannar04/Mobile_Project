<?xml version="1.0" encoding="utf-8" ?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anilove_bg"
    android:fillViewport="true"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
    >
        <!-- Top Header Bar -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/home_filter_btn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
            >
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_anilove_logo"
                />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/auth_app_title"
                    android:textColor="@color/anilove_text_dark"
                    android:textSize="22sp"
                    android:textStyle="bold"
                />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/home_filter_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_toStartOf="@id/home_notifications_btn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_shell_explore"
                app:tint="?attr/colorPrimary"
            />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/home_notifications_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/anilove_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_flow_notifications"
                app:tint="?attr/colorPrimary"
            />
        </RelativeLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/home_search_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/anilove_search_bg"
            app:drawableStartCompat="@drawable/ic_shell_search"
            app:drawableTint="?attr/colorOnSurface"
            android:drawablePadding="12dp"
            android:hint="Tìm kiếm thú cưng..."
            android:paddingHorizontal="16dp"
            android:textColor="@color/anilove_text_dark"
            android:textColorHint="@color/anilove_text_muted"
            android:textSize="14sp"
        />

        <!-- Facebook-style Post Box ("What's on your mind?") -->
        <LinearLayout
            android:id="@+id/home_create_post_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/anilove_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp"
        >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
            >
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Avatar"
                    android:src="@drawable/profile_avatar_default"
                    app:tint="?attr/colorOnSurface"
                />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/anilove_search_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Bạn đang nghĩ gì, muốn chia sẻ điều gì?"
                    android:textColor="@color/anilove_text_muted"
                    android:textSize="14sp"
                />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/anilove_bg"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
            >
                <TextView
                    android:id="@+id/home_post_photo_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:drawableStartCompat="@drawable/ic_shell_photo"
                    app:drawableTint="?attr/colorOnSurface"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Ảnh / Video"
                    android:textColor="@color/anilove_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                />

                <TextView
                    android:id="@+id/home_post_status_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:drawableStartCompat="@drawable/ic_nav_chat"
                    app:drawableTint="?attr/colorOnSurface"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Bài viết / Chia sẻ"
                    android:textColor="@color/anilove_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                />
            </LinearLayout>
        </LinearLayout>

        <!-- Categories horizontal chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
        >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
            >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/anilove_chip_bg"
                    android:backgroundTint="?attr/colorPrimary"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Tất cả"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/anilove_chip_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Chó"
                    android:textColor="@color/anilove_text_dark"
                />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/anilove_chip_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Mèo"
                    android:textColor="@color/anilove_text_dark"
                />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/anilove_chip_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Thỏ"
                    android:textColor="@color/anilove_text_dark"
                />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Thú cưng nổi bật"
            android:textColor="@color/anilove_text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
        />

        <!-- Pet Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_pet_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
        />

        <!-- Community Posts Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bài viết mới từ Cộng đồng"
            android:textColor="@color/anilove_text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
        />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_posts_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
