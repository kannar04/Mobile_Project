<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anilove_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/pet_detail_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image & Navigation -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:id="@+id/pet_detail_hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Pet Image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_avatar_dog" />

                <ImageView
                    android:id="@+id/pet_detail_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/anilove_chip_bg"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/anilove_text_dark" />

                <ImageView
                    android:id="@+id/pet_detail_favorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/anilove_chip_bg"
                    android:contentDescription="Favorite"
                    android:padding="8dp"
                    android:src="@drawable/ic_nav_favorite"
                    app:tint="@color/anilove_primary" />
            </FrameLayout>

            <!-- Main Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:background="@drawable/anilove_card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/pet_detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bông"
                    android:textColor="@color/anilove_text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pet_detail_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chó Cỏ • Quận 7, TP.HCM"
                    android:textColor="@color/anilove_text_muted"
                    android:textSize="14sp" />

                <!-- 3 Attributes Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/anilove_chip_bg"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giống"
                            android:textColor="@color/anilove_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/pet_detail_breed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Chó Cỏ"
                            android:textColor="@color/anilove_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/anilove_chip_bg"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tuổi"
                            android:textColor="@color/anilove_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/pet_detail_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 tháng"
                            android:textColor="@color/anilove_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/anilove_chip_bg"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cân nặng"
                            android:textColor="@color/anilove_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/pet_detail_weight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="4 kg"
                            android:textColor="@color/anilove_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Description Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Về Bông"
                    android:textColor="@color/anilove_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pet_detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Bông rất ngoan, quấn người và đã được tiêm phòng đầy đủ. Rất thích chơi bóng và đi dạo công viên."
                    android:textColor="@color/anilove_text_dark"
                    android:textSize="14sp" />

                <!-- Host Card -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/anilove_chip_bg"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/pet_detail_host_avatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:contentDescription="Host Avatar"
                        android:src="@drawable/profile_avatar_default" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/pet_detail_host_avatar"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pet_detail_host_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lan Anh"
                            android:textColor="@color/anilove_text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chủ hộ / Trại cứu hộ"
                            android:textColor="@color/anilove_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pet_detail_contact_btn"
                        style="@style/AniLoveOutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:paddingHorizontal="12dp"
                        android:text="Liên hệ"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Action Bar -->
    <FrameLayout
        android:id="@+id/pet_detail_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pet_detail_adopt_btn"
            style="@style/AniLovePrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhận nuôi" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
