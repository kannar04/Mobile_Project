<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/anilove_card_bg"
    android:orientation="vertical"
    android:padding="16dp"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
    >
        <ImageView
            android:id="@+id/host_applicant_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Avatar"
            android:src="@drawable/profile_avatar_default"
        />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
        >
            <TextView
                android:id="@+id/host_applicant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lan Anh"
                android:textColor="@color/anilove_text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
            />

            <TextView
                android:id="@+id/host_app_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Xin nhận nuôi Bé Bông (Poodle)"
                android:textColor="@color/anilove_text_muted"
                android:textSize="13sp"
            />
        </LinearLayout>

        <TextView
            android:id="@+id/host_app_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/anilove_badge_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Chờ duyệt"
            android:textColor="@color/anilove_badge_orange_text"
            android:textSize="11sp"
            android:textStyle="bold"
        />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
    >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_host_reject"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Từ chối"
        />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_host_accept"
            style="@style/AniLovePrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Chấp nhận"
        />
    </LinearLayout>
</LinearLayout>
