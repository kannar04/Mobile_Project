<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/anilove_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout android:id="@+id/auth_startup_loading" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="300dp" android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/profile_loading" android:textAppearance="?attr/textAppearanceBodyLarge" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <com.gmail.manhle240406.project.auth.BoundedFormLayout
            android:id="@+id/auth_form"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_back"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_social_back"
                app:iconTint="@color/anilove_text_dark"
                android:contentDescription="@string/auth_back" />

            <!-- AniLove Header & Logo -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_anilove_logo" />

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/auth_app_title"
                android:textColor="@color/anilove_text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auth_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/auth_app_subtitle"
                android:textColor="@color/anilove_text_muted"
                android:textSize="14sp" />

            <!-- Input Fields Container -->
            <LinearLayout
                android:id="@+id/auth_credentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/auth_email_layout"
                    style="@style/AniLoveOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/auth_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:autofillHints="username"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/auth_password_layout"
                    style="@style/AniLoveOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/auth_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:saveEnabled="false"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/auth_confirm_layout"
                    style="@style/AniLoveOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_confirm"
                    android:visibility="gone"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/auth_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:saveEnabled="false"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/auth_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/anilove_text_dark"
                android:textSize="14sp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/auth_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_submit"
                style="@style/AniLovePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/auth_signin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_google"
                style="@style/AniLoveOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/auth_google" />

            <TextView
                android:id="@+id/auth_google_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_google_unavailable"
                android:textColor="@color/anilove_text_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_switch"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/anilove_primary"
                android:text="@string/auth_switch_signin" />

            <!-- Extended Actions Container -->
            <LinearLayout
                android:id="@+id/auth_account_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_verify"
                    style="@style/AniLovePrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_verify" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_refresh"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_retry_setup"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_retry_setup" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_profile"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_pets"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_listings"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/listing_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_community"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/community_title" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/auth_proof_layout"
                    style="@style/AniLoveOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_proof"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/auth_proof"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:saveEnabled="false"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auth_link"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_google_link" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_logout"
                style="@style/AniLoveOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_logout"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/auth_disclosure"
                android:textColor="@color/anilove_text_muted"
                android:textSize="11sp" />
        </com.gmail.manhle240406.project.auth.BoundedFormLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
