<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Project" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/anilove_primary</item>
        <item name="colorOnPrimary">@color/anilove_on_primary</item>
        <item name="colorPrimaryContainer">@color/anilove_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/anilove_text_dark</item>
        <item name="colorSurface">@color/anilove_surface</item>
        <item name="colorOnSurface">@color/anilove_text_dark</item>
        <item name="colorOnSurfaceVariant">@color/anilove_text_muted</item>
        <item name="android:windowBackground">@color/anilove_bg</item>
        <item name="android:statusBarColor">@color/anilove_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Project" parent="Base.Theme.Project" />

    <!-- AniLove Primary Coral Button -->
    <style name="AniLovePrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/anilove_primary</item>
        <item name="android:textColor">@color/anilove_on_primary</item>
        <item name="cornerSize">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- AniLove Outlined Button -->
    <style name="AniLoveOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/anilove_primary</item>
        <item name="android:textColor">@color/anilove_primary</item>
        <item name="cornerSize">14dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- AniLove Outlined Field -->
    <style name="AniLoveOutlinedField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/anilove_primary</item>
        <item name="hintTextColor">@color/anilove_text_muted</item>
    </style>
</resources>
