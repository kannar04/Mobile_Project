<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/enhanced_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anilove_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_back" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp"
            app:navigationIcon="@drawable/ic_social_back" app:navigationIconTint="?attr/colorOnSurface"
            app:navigationContentDescription="@string/flow_back" app:title="@string/wiring_settings_title"
            app:titleTextColor="?attr/colorOnSurface" app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/anilove_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_system_options"
                android:textColor="@color/anilove_text_dark"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-medium"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_setting_account"
                style="@style/AniLoveSettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="👤 Tài khoản &amp; Bảo mật"
                android:textColor="@color/anilove_text_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_setting_language"
                style="@style/AniLoveSettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="🌐 Ngôn ngữ (Tiếng Việt / English)"
                android:textColor="@color/anilove_text_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_setting_theme"
                style="@style/AniLoveSettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="🎨 Giao diện (Sáng / Tối)"
                android:textColor="@color/anilove_text_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_setting_security"
                style="@style/AniLoveSettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="🔒 Bảo mật &amp; Xác thực 2 yếu tố"
                android:textColor="@color/anilove_text_dark" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
