<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/handover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anilove_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
>
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_anilove_logo"
    />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Bàn giao Hoàn tất! 🎉"
        android:textColor="@color/anilove_text_dark"
        android:textSize="22sp"
        android:textStyle="bold"
    />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Thú cưng đã được bàn giao an toàn. Cập nhật nhật ký nhận nuôi trong 90 ngày tới."
        android:textColor="@color/anilove_text_muted"
        android:textSize="14sp"
    />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_handover_done"
        style="@style/AniLovePrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Quay lại Trang chủ"
    />
</LinearLayout>
