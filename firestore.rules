      allow get: if self(uid) && communicationPair(id) || communicationActive(id,false) && communicationAccount(request.auth.uid) && resource.data.consent==true && sharedCard(resource.data,id,uid);
      allow create: if self(uid) && communicationAccount(uid) && communicationActive(id,false) && sharedCard(request.resource.data,id,uid) && request.resource.data.consentVersion==1 && request.resource.data.updatedAt==request.time;
      allow update: if self(uid) && communicationPair(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent','consentVersion','phoneE164','sourceVersion','updatedAt','operationId']) && request.resource.data.consentVersion is int && request.resource.data.consentVersion==resource.data.consentVersion+1 && request.resource.data.updatedAt==request.time && validId(request.resource.data.operationId)
        && (request.resource.data.consent==false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent','consentVersion','updatedAt','operationId']) || communicationAccount(uid) && communicationActive(id,false) && sharedCard(request.resource.data,id,uid));
      allow list,delete: if false;
    }
    function sendReceipt(uid,op) {return getAfter(/databases/$(database)/documents/conversationReceipts/$(uid)/operations/$(op)).data;}
    function freshSendLink(uid,op,id,messageId) {let r=sendReceipt(uid,op);return self(uid) && validId(op) && !exists(/databases/$(database)/documents/conversationReceipts/$(uid)/operations/$(op)) && r.uid==uid && r.reservationId==id && r.messageId==messageId && r.operationId==op && r.committedAt==request.time;}
    function receiptInvariant(uid,op) {
      let r=request.resource.data;let id=r.reservationId;
      let cp=/databases/$(database)/documents/conversationCounters/$(id);let before=get(cp).data;let counter=getAfter(cp).data;
      let message=getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(r.messageId)).data;
      let rate=getAfter(/databases/$(database)/documents/conversationSendLimits/$(id)/members/$(uid)).data;
      let grant=communicationGrant(id);
      return self(uid) && r.keys().size()==9 && r.keys().hasOnly(['schemaVersion','uid','operationId','reservationId','messageId','inputDigest','baseVersion','sequence','committedAt']) && r.schemaVersion==1 && r.uid==uid && r.operationId==op && validId(op) && validId(id) && validId(r.messageId) && r.inputDigest.matches('[0-9a-f]{64}') && r.committedAt==request.time
        && !exists(/databases/$(database)/documents/conversations/$(id)/messages/$(r.messageId)) && r.baseVersion is int && r.sequence is int && r.baseVersion==before.version && r.sequence==before.nextSequence && before.messageCount<1000
        && counter.keys().size()==5 && counter.keys().hasOnly(['schemaVersion','reservationId','nextSequence','messageCount','version']) && counter.schemaVersion==1 && counter.reservationId==id && counter.nextSequence is int && counter.messageCount is int && counter.version is int && counter.nextSequence==before.nextSequence+1 && counter.messageCount==before.messageCount+1 && counter.version==before.version+1
        && message.senderUid==uid && message.reservationId==id && message.sequence==r.sequence && message.operationId==op && message.createdAt==request.time
        && rate.lastSentAt==request.time && rate.operationId==op
        && getAfter(/databases/$(database)/documents/users/$(grant.hostUid)/conversationIndex/$(id)).data.updatedAt==request.time
        && getAfter(/databases/$(database)/documents/users/$(grant.applicantUid)/conversationIndex/$(id)).data.updatedAt==request.time;
    }
    match /conversations/{id}/messages/{mid} {
      allow get: if communicationPair(id);allow list: if communicationPair(id) && page20();
      allow create: if communicationActive(id,true) && request.resource.data.keys().size()==9 && request.resource.data.keys().hasOnly(['schemaVersion','senderUid','reservationId','messageId','sequence','body','source','createdAt','operationId']) && request.resource.data.schemaVersion==1 && request.resource.data.senderUid==request.auth.uid && request.resource.data.reservationId==id && request.resource.data.messageId==mid && validId(mid) && request.resource.data.sequence is int && request.resource.data.body is string && request.resource.data.body.matches('(?s).{1,1000}.{0,1000}') && request.resource.data.body.toUtf8().size()<=8000 && request.resource.data.body==request.resource.data.body.trim() && request.resource.data.source=='participant_message' && request.resource.data.createdAt==request.time && freshSendLink(request.auth.uid,request.resource.data.operationId,id,mid);
      allow update,delete: if false;
    }
    match /conversationCounters/{id} {
      allow get: if communicationPair(id);allow list,create,delete: if false;
      allow update: if basicMemberReady(request.auth.uid) && freshSendLink(request.auth.uid,getAfter(/databases/$(database)/documents/conversationSendLimits/$(id)/members/$(request.auth.uid)).data.operationId,id,sendReceipt(request.auth.uid,getAfter(/databases/$(database)/documents/conversationSendLimits/$(id)/members/$(request.auth.uid)).data.operationId).messageId);
    }
    match /conversationSendLimits/{id}/members/{uid} {
      allow get: if self(uid) && communicationPair(id);allow list,delete: if false;
      allow create,update: if self(uid) && request.resource.data.keys().size()==5 && request.resource.data.keys().hasOnly(['uid','lastSentAt','version','operationId','reservationId']) && request.resource.data.uid==uid && request.resource.data.reservationId==id && request.resource.data.version is int && request.resource.data.version==(exists(/databases/$(database)/documents/conversationSendLimits/$(id)/members/$(uid))?resource.data.version+1:1) && request.resource.data.lastSentAt==request.time && (!exists(/databases/$(database)/documents/conversationSendLimits/$(id)/members/$(uid)) || request.time>=resource.data.lastSentAt+duration.value(2,'s')) && freshSendLink(uid,request.resource.data.operationId,id,sendReceipt(uid,request.resource.data.operationId).messageId);
    }
    match /conversationReceipts/{uid}/operations/{op} {allow get: if profileOwner(uid);allow list: if profileOwner(uid) && page20();allow create: if receiptInvariant(uid,op);allow update,delete: if false;}
    match /users/{uid}/conversationIndex/{id} {
      allow get: if profileOwner(uid);allow list: if profileOwner(uid) && page20();allow create,delete: if false;
      allow update: if request.auth!=null && communicationPair(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']) && request.resource.data.updatedAt==request.time && getAfter(/databases/$(database)/documents/conversationCounters/$(id)).data.version==get(/databases/$(database)/documents/conversationCounters/$(id)).data.version+1
        || profileOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadSequence']) && request.resource.data.lastReadSequence is int && request.resource.data.lastReadSequence>=resource.data.lastReadSequence && request.resource.data.lastReadSequence<get(/databases/$(database)/documents/conversationCounters/$(id)).data.nextSequence;
    }


    // F05/F39/F44/F23?F28 r1 and F08 r4: private reads; trusted-only domain mutations.
    function scopeAllows(uid,scope) {let r=get(/databases/$(database)/documents/accountRestrictionState/$(uid));return r==null || r.data.schemaVersion==1 && r.data.scopes is list && !(scope in r.data.scopes);}
    function operatorCan(cap) {let c=get(/databases/$(database)/documents/operatorCapabilities/$(request.auth.uid));return request.auth!=null && profileOwner(request.auth.uid) && request.auth.token.email_verified==true && active(request.auth.uid) && c!=null && c.data.schemaVersion==1 && c.data.active==true && cap in c.data.capabilities && scopeAllows(request.auth.uid,'reviewer_access');}
    match /operatorCapabilities/{uid} {allow get: if profileOwner(uid);allow list,write: if false;}
    match /adminAccountDirectory/{uid} {allow get: if operatorCan('account_lookup') && resource.data.keys().hasOnly(['schemaVersion','uid','alias','aliasKey','status','createdAt','directoryVersion']);allow list: if operatorCan('account_lookup') && get(/databases/$(database)/documents/safetyRuntimePolicy/current).data.directoryAdaptersEnabled==true && page20();allow write: if false;}
    match /accountRestrictionState/{uid} {allow get: if profileOwner(uid);allow list,write: if false;}
    match /users/{uid}/{kind}/{id} {allow get: if kind in ['accountNotices','decisionNotices','welfareStatus','supportStatus','followupIndex','returnIndex','experienceFeedback'] && profileOwner(uid);allow list: if kind in ['accountNotices','decisionNotices','welfareStatus','supportStatus','followupIndex','returnIndex','experienceFeedback'] && profileOwner(uid) && page20();allow write: if false;}
    match /{module}/{uid}/operations/{op} {allow get: if module in ['accountAdminReceipts','decisionReviewReceipts','moderationReceipts','supportReceipts','followupReceipts','followupDeadlineReceipts','welfareReceipts','returnReceipts','experienceReviewReceipts'] && profileOwner(uid);allow list: if module in ['accountAdminReceipts','decisionReviewReceipts','moderationReceipts','supportReceipts','followupReceipts','followupDeadlineReceipts','welfareReceipts','returnReceipts','experienceReviewReceipts'] && profileOwner(uid) && page20();allow write: if false;}
    match /moderationQueue/{id} {allow get: if operatorCan('report_review') || operatorCan('content_review');allow list: if (operatorCan('report_review') || operatorCan('content_review')) && page20();allow write: if false;}
    match /reviewAssignments/{id} {allow get: if request.auth!=null && self(resource.data.reviewerUid) && (operatorCan('report_review') || operatorCan('content_review'));allow list,write: if false;}
    match /welfareQueue/{id} {allow get: if operatorCan('welfare_review');allow list: if operatorCan('welfare_review') && page20();allow write: if false;}
    match /welfareCases/{id} {allow read,write: if false;match /statements/{revision} {allow get: if request.auth!=null && self(resource.data.uid) && profileOwner(request.auth.uid);allow list: if request.auth!=null && self(resource.data.uid) && profileOwner(request.auth.uid) && page20();allow write: if false;}}
    match /supportRequests/{id} {allow get: if profileOwner(resource.data.requesterUid) || request.auth!=null && self(resource.data.reviewerUid) && operatorCan('support_reply');allow list,write: if false;match /messages/{mid} {allow get: if profileOwner(get(/databases/$(database)/documents/supportRequests/$(id)).data.requesterUid) || request.auth!=null && self(get(/databases/$(database)/documents/supportRequests/$(id)).data.reviewerUid) && operatorCan('support_reply');allow list: if page20() && (profileOwner(get(/databases/$(database)/documents/supportRequests/$(id)).data.requesterUid) || request.auth!=null && self(get(/databases/$(database)/documents/supportRequests/$(id)).data.reviewerUid) && operatorCan('support_reply'));allow write: if false;}}
    match /careGuidance/{id}/revisions/{v} {allow get: if resource.data.keys().hasOnly(['schemaVersion','articleId','version','state','scope','title','body','sourceUrls','editorUid','reviewedAt']) && resource.data.schemaVersion==1 && resource.data.articleId==id && resource.data.reviewedAt is timestamp && resource.data.reviewedAt<=request.time && resource.data.state=='published' && resource.data.scope=='general_information' && resource.data.sourceUrls is list && resource.data.sourceUrls.size()>0;allow list,write: if false;}
    function followupReader(id) {let p=get(/databases/$(database)/documents/followupPlans/$(id)).data;let g=get(/databases/$(database)/documents/followupAccess/$(id)).data;let pet=get(/databases/$(database)/documents/pets/$(p.petId)).data;return request.auth!=null && profileOwner(request.auth.uid) && g.state=='active' && pet.editorUid==p.caregiverUid && pet.custodyVersion==p.custodyVersion && (request.auth.uid==p.caregiverUid || request.time<=p.periodEnd && (request.auth.uid in g.readerUids || request.auth.uid in g.reviewerUids && operatorCan('followup_review')));}
    match /followupPlans/{id} {allow get: if followupReader(id);allow list,write: if false;match /tasks/{task} {allow get: if followupReader(id);allow list: if followupReader(id) && request.query.limit!=null && request.query.limit<=6;allow write: if false;match /revisions/{v} {allow get: if followupReader(id);allow list: if followupReader(id) && page20();allow write: if false;}}}
    match /followupActivationConsents/{id} {allow get: if request.auth!=null && profileOwner(request.auth.uid) && (self(resource.data.caregiverUid) || self(resource.data.hostUid));allow list,write: if false;}
    match /followupExtensionRequests/{id} {allow get: if profileOwner(resource.data.caregiverUid);allow list,write: if false;}
    match /returnRequests/{id} {allow get: if profileOwner(resource.data.requesterUid) || profileOwner(resource.data.caregiverUid);allow list,write: if false;}
    function returnParty(id) {let r=get(/databases/$(database)/documents/returnTransfers/$(id)).data;return request.auth!=null && profileOwner(request.auth.uid) && (request.auth.uid==r.caregiverUid || request.auth.uid==r.receiverUid);}
    match /returnTransfers/{id} {allow get: if returnParty(id);allow list,write: if false;match /consents/{uid} {allow get: if returnParty(id);allow list,write: if false;}match /confirmations/{uid}/revisions/{v} {allow get: if returnParty(id);allow list: if returnParty(id) && page20();allow write: if false;}}
    match /decisionAppeals/{id} {allow get: if profileOwner(resource.data.subjectUid);allow list,write: if false;match /addenda/{v} {allow get: if profileOwner(get(/databases/$(database)/documents/decisionAppeals/$(id)).data.subjectUid);allow list: if profileOwner(get(/databases/$(database)/documents/decisionAppeals/$(id)).data.subjectUid) && page20();allow write: if false;}}
    match /experienceReviews/{id} {allow get: if profileOwner(resource.data.reviewerUid);allow list,write: if false;match /revisions/{v} {allow get: if profileOwner(get(/databases/$(database)/documents/experienceReviews/$(id)).data.reviewerUid);allow list: if profileOwner(get(/databases/$(database)/documents/experienceReviews/$(id)).data.reviewerUid) && page20();allow write: if false;}}
    function publicFeedback(uid) {let own=get(/databases/$(database)/documents/users/$(request.auth.uid));let c=get(/databases/$(database)/documents/publicFeedbackConsents/$(uid));let profile=get(/databases/$(database)/documents/publicProfiles/$(uid));let control=get(/databases/$(database)/documents/publicProfileControls/$(uid));let h=get(/databases/$(database)/documents/profileModeration/$(uid));return request.auth!=null && own!=null && own.data.uid==request.auth.uid && own.data.schemaVersion==1 && own.data.keys().size()==3 && c!=null && c.data.enabled==true && profile!=null && control!=null && control.data.visibility=='public' && h!=null && h.data.hold=='clear' && get(/databases/$(database)/documents/safetyRuntimePolicy/current).data.publicFeedbackAdaptersEnabled==true;}
    match /publicExperienceReviews/{id} {allow get: if publicFeedback(resource.data.subjectUid) && resource.data.subjectConsentVersion==get(/databases/$(database)/documents/publicFeedbackConsents/$(resource.data.subjectUid)).data.version && resource.data.profileVersion==get(/databases/$(database)/documents/publicProfiles/$(resource.data.subjectUid)).data.publicationVersion && get(/databases/$(database)/documents/experienceReviewClearance/$(get(/databases/$(database)/documents/publicExperienceReviewGuards/$(id)).data.sourceReviewId)).data.state=='clear';allow list: if publicFeedback(resource.data.subjectUid) && page20();allow write: if false;}
    match /experienceReviewAggregates/{uid} {allow get: if publicFeedback(uid);allow list,write: if false;}

    // F43 safe own status only; all managed work/hold/lifecycle writes remain denied.
    match /users/{uid}/closureViews/{requestId} {
      allow get: if self(uid) && resource.data.keys().size()==9
        && resource.data.keys().hasOnly(['schemaVersion','ownerUid','requestId','phase','version','policyVersion','manifestVersion','acceptedAt','updatedAt'])
        && resource.data.schemaVersion==1 && resource.data.ownerUid==uid && resource.data.requestId==requestId
        && resource.data.version is int && resource.data.version>=1 && resource.data.policyVersion is int && resource.data.policyVersion>=1
        && resource.data.manifestVersion is int && resource.data.manifestVersion>=1
        && resource.data.phase in ['received_needs_inventory','closing','inventory_or_case_review','public_removal_in_progress','erasing','provider_delete_pending','completed_scope','needs_operator']
        && resource.data.acceptedAt is timestamp && resource.data.updatedAt is timestamp;
      allow list,write: if false;
    }

    // F06_TEST_PROBE_ANCHOR: only the emulator test loader injects a temporary predicate probe.
    // F32-F41 scoped extensions: all consequential writes remain managed-only.
    function extensionOn(key) {let p=get(/databases/$(database)/documents/extensionRuntimePolicy/current);return p!=null && p.data.schemaVersion==1 && p.data.get(key,false)==true;}
    function extensionMember() {return request.auth!=null && basicMemberReady(request.auth.uid);}
    function noticeClaimParty(n,c) {let notice=get(/databases/$(database)/documents/lostFoundNotices/$(n));let claim=get(/databases/$(database)/documents/noticeClaims/$(n)/claims/$(c));return request.auth!=null && profileOwner(request.auth.uid) && notice!=null && claim!=null && (request.auth.uid==notice.data.authorUid || request.auth.uid==claim.data.claimantUid);}
    function extensionSubjectActive(uid) {let s=get(/databases/$(database)/documents/securitySubjects/$(uid));let m=get(/databases/$(database)/documents/communityMemberships/$(uid));return (s==null || s.data.status=='active') && m!=null && m.data.status=='active';}
    function currentNotice(id) {let n=get(/databases/$(database)/documents/lostFoundNotices/$(id));return n!=null && n.data.state=='open' && n.data.hold=='clear' && n.data.expiresAt>request.time && extensionSubjectActive(n.data.authorUid) && scopeAllows(n.data.authorUid,'community_publication');}
    match /lostFoundFeed/{id} {
      allow get: if extensionOn('lostFoundPublication') && extensionMember() && currentNotice(id) && resource.data.keys().hasOnly(['schemaVersion','noticeId','authorUid','contentVersion','state','firstPublishedAt','expiresAt','type','regionId','speciesId','description','eventDate','precision','zoneId','media']);
      // Managed bounded page reader rechecks every source; no unsafe cross-parent SDK query.
      allow list,write: if false;
    }
    match /lostFoundNotices/{id} {allow get: if profileOwner(resource.data.authorUid);allow list,write: if false;match /revisions/{revision} {allow get: if profileOwner(get(/databases/$(database)/documents/lostFoundNotices/$(id)).data.authorUid);allow list,write: if false;}}
    match /noticeProof/{id} {allow get: if profileOwner(resource.data.authorUid);allow list,write: if false;}
    match /noticeClaims/{n}/claims/{c} {allow get: if noticeClaimParty(n,c);allow list,write: if false;match /revisions/{revision} {allow get: if noticeClaimParty(n,c);allow list,write: if false;}match /clarifications/{event} {allow get: if noticeClaimParty(n,c);allow list,write: if false;}}
    match /{kind}/{uid}/items/{id} {allow get: if kind in ['claimPartyViews','fosterPartyViews','exchangePartyViews'] && profileOwner(uid);allow list: if kind in ['claimPartyViews','fosterPartyViews','exchangePartyViews'] && profileOwner(uid) && page20();allow write: if false;}
    match /{kind}/{uid}/operations/{id} {allow get: if kind in ['lostFoundReceipts','fosterReceipts','exchangeReceipts','discoveryPreferenceReceipts','reminderReceipts','metricReceipts'] && profileOwner(uid);allow list: if kind in ['lostFoundReceipts','fosterReceipts','exchangeReceipts','discoveryPreferenceReceipts','reminderReceipts','metricReceipts'] && profileOwner(uid) && page20();allow write: if false;}
    match /careAdvertisements/{id} {allow get: if profileOwner(resource.data.authorUid);allow list,write: if false;}
    match /careAdvertFeed/{id} {allow get: if extensionMember() && extensionOn('fosterPublication') && resource.data.state=='published' && resource.data.startAt>request.time && extensionSubjectActive(resource.data.authorUid);allow list,write: if false;}
    match /fosterArrangements/{id} {allow get: if profileOwner(resource.data.ownerUid) || profileOwner(resource.data.caregiverUid);allow list,write: if false;}
    match /exchanges/{id} {allow get: if profileOwner(resource.data.proposerUid) || profileOwner(resource.data.recipientUid);allow list,write: if false;}
    match /exchangeProposals/{id} {allow get: if profileOwner(resource.data.proposerUid) || profileOwner(resource.data.recipientUid);allow list,write: if false;}
    match /users/{uid}/recommendationPreferences/{id} {allow get: if profileOwner(uid) && id=='current';allow list,write: if false;}
    match /users/{uid}/discoveryPreferences/{id} {allow get: if profileOwner(uid) && id=='nearby';allow list,write: if false;}
    function ownCurrentReminder(uid,d) {let entitlement=get(/databases/$(database)/documents/caregiverEntitlements/$(d.petId));let pet=get(/databases/$(database)/documents/pets/$(d.petId));return profileOwner(uid) && d.ownerUid==uid && entitlement!=null && pet!=null && pet.data.lifecycle=='active' && entitlement.data.currentUid==uid && entitlement.data.state=='active' && entitlement.data.custodyVersion==d.custodyVersion && pet.data.custodyVersion==d.custodyVersion;}
    match /users/{uid}/careReminders/{id} {allow get: if extensionOn('careReminders') && ownCurrentReminder(uid,resource.data);allow list: if extensionOn('careReminders') && request.query.limit!=null && request.query.limit>0 && request.query.limit<=50 && ownCurrentReminder(uid,resource.data);allow write: if false;match /revisions/{revision} {allow get: if ownCurrentReminder(uid,resource.data);allow list,write: if false;}}
    match /reminderScheduleIntents/{uid}/items/{id} {allow get: if profileOwner(uid);allow list,write: if false;}
    // Dashboard sources/contributions/aggregates, private transfer terms, review
    // decisions and source adapters have no raw SDK access, even for Admin.
    match /{document=**} { allow read, write: if false; }
  }
}
