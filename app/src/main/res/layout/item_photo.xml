<?xml version="1.0" encoding="utf-8" ?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_margin="6dp"
    android:background="@drawable/anilove_card_bg"
    android:clickable="true"
    android:focusable="true"
>
    <ImageView
        android:id="@+id/photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_avatar_dog"
    />

    <!-- Cover Badge -->
    <TextView
        android:id="@+id/photo_cover_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/anilove_badge_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="Ảnh bìa"
        android:textColor="@color/anilove_badge_green_text"
        android:textSize="11sp"
        android:textStyle="bold"
    />

    <!-- Progress Overlay -->
    <LinearLayout
        android:id="@+id/photo_progress_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="8dp"
    >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Đang tải lên (60%)"
            android:textColor="@color/white"
            android:textSize="11sp"
        />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:progress="60"
        />
    </LinearLayout>
</RelativeLayout>
