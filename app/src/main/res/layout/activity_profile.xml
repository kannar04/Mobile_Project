<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/anilove_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Navigation Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:textColor="@color/anilove_text_dark"
                android:text="@string/auth_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/profile_back"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="@string/profile_title"
                android:textColor="@color/anilove_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>





        <!-- User Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/anilove_card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/profile_avatar_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Avatar"
                android:src="@drawable/profile_avatar_default"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/profile_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_none"
                android:textColor="@color/anilove_text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />



            <!-- Profile Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_edit"
                    style="@style/AniLovePrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/social_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_options"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/social_menu" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/profile_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_tools"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/flow_explore" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_settings"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wiring_settings_title" />

        <TextView
            android:id="@+id/profile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/anilove_text_dark"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_retry"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_retry_operation"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_resolve"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_resolve_conflict"
            android:visibility="gone" />

        <!-- Form Section -->
        <LinearLayout
            android:id="@+id/profile_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:saveEnabled="false">

            <LinearLayout
                android:id="@+id/profile_public_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/profile_name_layout"
                    style="@style/AniLoveOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <Spinner
                    android:id="@+id/profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/profile_region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/profile_bio_layout"
                    style="@style/AniLoveOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_bio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/profile_draft_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_save"
                    style="@style/AniLovePrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/profile_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_preview"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_preview" />
            </LinearLayout>

            <!-- Contact Section -->
            <LinearLayout
                android:id="@+id/profile_contact_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/profile_phone_layout"
                    style="@style/AniLoveOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_phone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_save_contact"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_save_contact" />
            </LinearLayout>

            <!-- Visibility Section -->
            <LinearLayout
                android:id="@+id/profile_visibility_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/profile_visibility_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_hide"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_hide" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_show"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_show" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_reviews"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_reviews" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_more"
                    style="@style/AniLoveOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_more_reviews"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/profile_review_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_reload"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_reload"
            android:visibility="gone" />

        <!-- Management & Settings -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_pets"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pet_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_listings"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/listing_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_notifications"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/notification_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_catalogs"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/catalog_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_review"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/listing_review_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_discovery"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/discovery_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_pet_care"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pet_care_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_logout"
            style="@style/AniLoveOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/listing_logout_now" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
