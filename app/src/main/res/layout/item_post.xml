<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/anilove_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Post Author Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/post_author_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Avatar"
            android:src="@drawable/profile_avatar_dog" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/post_author_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nguyễn Lan Anh"
                android:textColor="@color/anilove_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/post_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 giờ trước · Cứu hộ thú cưng"
                android:textColor="@color/anilove_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Post Body Text -->
    <TextView
        android:id="@+id/post_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Hôm nay dẫn bé Bông đi công viên chơi siêu ngoan nè mọi người! 🐶❤️ Bé rất hòa đồng và thích chơi với các bạn chó khác."
        android:textColor="@color/anilove_text_dark"
        android:textSize="14sp" />

    <!-- Post Image -->
    <ImageView
        android:id="@+id/post_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Post image"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_avatar_dog" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/anilove_bg" />

    <!-- Post Actions (Like, Comment, Share) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/post_like_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_nav_favorite"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="124 Yêu thích"
            android:textColor="@color/anilove_text_dark"
            android:textSize="13sp"
            app:drawableTint="@color/anilove_primary" />

        <TextView
            android:id="@+id/post_comment_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_nav_chat"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="18 Bình luận"
            android:textColor="@color/anilove_text_dark"
            android:textSize="13sp"
            app:drawableTint="@color/anilove_primary" />

        <TextView
            android:id="@+id/post_share_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_nav_home"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="Chia sẻ"
            android:textColor="@color/anilove_text_dark"
            android:textSize="13sp"
            app:drawableTint="@color/anilove_primary" />
    </LinearLayout>
</LinearLayout>
