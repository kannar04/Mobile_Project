<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/discovery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anilove_bg"
    android:orientation="vertical"
    android:padding="16dp"
>
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/discovery_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_social_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:navigationContentDescription="@string/flow_back"
        app:title="@string/flow_discover"
        app:titleTextColor="?attr/colorOnSurface"
    />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/wiring_search"
        app:boxBackgroundMode="outline"
        app:endIconMode="clear_text"
        style="@style/AuthField"
    >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/discovery_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:inputType="text"
            android:imeOptions="actionSearch"
        />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout
        android:id="@+id/discovery_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
    />
    <TextView
        android:id="@id/flow_filter_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/anilove_text_muted"
        android:textSize="14sp"
        android:paddingVertical="8dp"
    />
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/discovery_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
    />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/discovery_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
    />
</LinearLayout>
