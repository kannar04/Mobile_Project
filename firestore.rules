rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function self(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // F42 r2: separate ordinary community enrollment; protected memberReady/active unchanged.
    function subjectPermitsCommunity(uid) {
      let path=/databases/$(database)/documents/securitySubjects/$(uid);
      return !exists(path) || (get(path).data.keys().hasOnly(['status','roles','updatedAt'])
        && get(path).data.keys().hasAll(['status','roles','updatedAt']) && get(path).data.status == 'active'
        && get(path).data.roles is list && get(path).data.updatedAt is timestamp);
    }
    function membershipShape(d,uid) {
      return d.keys().size()==6 && d.keys().hasOnly(['uid','schemaVersion','status','membershipVersion','createdAt','updatedAt'])
        && d.uid==uid && d.schemaVersion is int && d.schemaVersion==1 && d.status in ['active','restricted']
        && d.membershipVersion is int && d.membershipVersion>=1 && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    function basicMemberReady(uid) {
      let m=get(/databases/$(database)/documents/communityMemberships/$(uid)).data;
      return profileOwner(uid) && request.auth.token.email_verified==true && membershipShape(m,uid)
        && m.status=='active' && subjectPermitsCommunity(uid);
    }
    match /communityMemberships/{uid} {
      allow get: if self(uid);
      allow create: if profileOwner(uid) && request.auth.token.email_verified==true && subjectPermitsCommunity(uid)
        && membershipShape(request.resource.data,uid) && request.resource.data.status=='active'
        && request.resource.data.membershipVersion==1 && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
      allow list,update,delete: if false;
    }
    function active(uid) {
      return self(uid) &&
        get(/databases/$(database)/documents/securitySubjects/$(uid)).data.status == 'active';
    }
    function validId(id) {
      return id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}');
    }
    function profileOwner(uid) {
      return self(uid) && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.keys().size()==3
        && get(/databases/$(database)/documents/users/$(uid)).data.keys().hasOnly(['uid','schemaVersion','createdAt'])
        && get(/databases/$(database)/documents/users/$(uid)).data.createdAt is timestamp
        && get(/databases/$(database)/documents/users/$(uid)).data.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.schemaVersion == 1;
    }
    function unicodeBound(s,min,max,bytes){return s is string && s.matches('(?s).{'+string(min)+','+string(max)+'}') && s.toUtf8().size()<=bytes && (s=='' || s.matches('(?s).*[^\\s\\x00-\\x1f\\x7f].*'));}
    function content(d) {
      return unicodeBound(d.displayName,2,40,160) && d.displayName==d.displayName.trim()
        && unicodeBound(d.bio,0,500,2000) && d.avatarKey in ['default','cat','dog']
        && (d.regionCode == null || d.regionCode in ['north','central','south']);
    }
    function ownerVersion(d, uid) {
      return d.ownerUid == uid && d.schemaVersion is int && d.schemaVersion == 1
        && d.version is int && d.version >= 1 && d.lastOperationId is string && validId(d.lastOperationId)
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }
    function nextVersion() {
      return request.resource.data.version == resource.data.version + 1
        && request.resource.data.lastOperationId != resource.data.lastOperationId;
    }
    function publicShape(d,uid) {
      return d.keys().hasOnly(['ownerUid','schemaVersion','publicationVersion','sourceDraftVersion','displayName','avatarKey','regionCode','bio','publishedAt'])
        && d.keys().hasAll(['ownerUid','schemaVersion','publicationVersion','sourceDraftVersion','displayName','avatarKey','regionCode','bio','publishedAt'])
        && d.ownerUid == uid && d.schemaVersion is int && d.schemaVersion == 1
        && d.publicationVersion is int && d.publicationVersion >= 1
        && d.sourceDraftVersion is int && d.sourceDraftVersion >= 1 && content(d) && d.publishedAt is timestamp;
    }
    function controlShape(d,uid) {
      return d.keys().hasOnly(['ownerUid','schemaVersion','version','visibility','lastOperationId','updatedAt'])
        && d.keys().hasAll(['ownerUid','schemaVersion','version','visibility','lastOperationId','updatedAt'])
        && d.ownerUid == uid && d.schemaVersion is int && d.schemaVersion == 1 && d.version is int && d.version >= 1
        && d.visibility in ['hidden','public'] && validId(d.lastOperationId) && d.updatedAt is timestamp;
    }
    function visible(uid) {
      let controls = get(/databases/$(database)/documents/publicProfileControls/$(uid)).data;
      return controlShape(controls,uid) && controls.visibility == 'public'
        && get(/databases/$(database)/documents/profileModeration/$(uid)).data.hold == 'clear';
    }
    function draftShape(d,uid) {
      return d.keys().hasOnly(['ownerUid','schemaVersion','version','displayName','avatarKey','regionCode','bio','submission','lastOperationId','updatedAt'])
        && d.keys().hasAll(['ownerUid','schemaVersion','version','displayName','avatarKey','regionCode','bio','submission','lastOperationId','updatedAt'])
        && ownerVersion(d,uid) && content(d) && d.submission in ['draft','submitted'];
    }
    match /users/{uid}/profileDraft/current {
      allow get: if self(uid);
      allow create: if profileOwner(uid) && draftShape(request.resource.data,uid)
        && request.resource.data.version == 1 && request.resource.data.submission == 'draft';
      allow update: if profileOwner(uid) && draftShape(request.resource.data,uid) && nextVersion()
        && (request.resource.data.submission == 'draft' ||
          (resource.data.submission == 'draft' && request.resource.data.submission == 'submitted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submission','version','lastOperationId','updatedAt'])
            && active(uid) && request.auth.token.email_verified == true));
      allow list, delete: if false;
    }
    match /users/{uid}/private/contact {
      function contactShape(d) {
        return d.keys().hasOnly(['ownerUid','schemaVersion','version','phoneE164','lastOperationId','updatedAt'])
          && d.keys().hasAll(['ownerUid','schemaVersion','version','phoneE164','lastOperationId','updatedAt'])
          && ownerVersion(d,uid) && (d.phoneE164 == null || (d.phoneE164 is string && d.phoneE164.matches('[+][0-9]{7,15}')));
      }
      allow get: if self(uid);
      allow create: if profileOwner(uid) && contactShape(request.resource.data) && request.resource.data.version == 1;
      allow update: if profileOwner(uid) && contactShape(request.resource.data) && nextVersion();
      allow list, delete: if false;
    }
    function profileHold(d,uid) {
      return d.keys().size()==7 && d.keys().hasOnly(['schemaVersion','ownerUid','hold','moderationVersion','reasonCode','decisionId','updatedAt'])
        && d.schemaVersion is int && d.schemaVersion==1 && d.ownerUid==uid && d.hold in ['clear','held'] && d.moderationVersion is int && d.moderationVersion>=1
        && (d.reasonCode==null || d.reasonCode is string) && (d.decisionId==null || d.decisionId is string) && d.updatedAt is timestamp;
    }
    match /profileModeration/{uid} {
      allow get: if self(uid);
      allow create: if profileOwner(uid) && profileHold(request.resource.data,uid) && request.resource.data.hold=='clear'
        && request.resource.data.moderationVersion==1 && request.resource.data.reasonCode==null && request.resource.data.decisionId==null
        && request.resource.data.updatedAt==request.time && !exists(/databases/$(database)/documents/users/$(uid)/profileDraft/current)
        && getAfter(/databases/$(database)/documents/users/$(uid)/profileDraft/current).data.updatedAt==request.time;
      allow list,update,delete: if false;
    }
    function profilePublication(uid,op) {
      let r=getAfter(/databases/$(database)/documents/users/$(uid)/profileOperations/$(op)).data;
      let d=get(/databases/$(database)/documents/users/$(uid)/profileDraft/current).data;
      let c=getAfter(/databases/$(database)/documents/publicProfileControls/$(uid)).data;
      let p=getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data;
      let h=get(/databases/$(database)/documents/profileModeration/$(uid)).data;
      return basicMemberReady(uid) && profileHold(h,uid) && h.hold=='clear' && r.base.moderation==h.moderationVersion
        && !exists(/databases/$(database)/documents/users/$(uid)/profileOperations/$(op))
        && r.command=='publish' && r.consent==true && r.base.draft==d.version && r.input=={'displayName':d.displayName,'avatarKey':d.avatarKey,'regionCode':d.regionCode,'bio':d.bio}
        && r.base.control==(exists(/databases/$(database)/documents/publicProfileControls/$(uid))?get(/databases/$(database)/documents/publicProfileControls/$(uid)).data.version:0)
        && r.base.publication==(exists(/databases/$(database)/documents/publicProfiles/$(uid))?get(/databases/$(database)/documents/publicProfiles/$(uid)).data.publicationVersion:0)
        && r.result=={'control':r.base.control+1,'publication':r.base.publication+1} && r.committedAt==request.time
        && c.lastOperationId==op && c.visibility=='public' && c.version==r.result.control && c.updatedAt==request.time
        && publicShape(p,uid) && p.publicationVersion==r.result.publication && p.sourceDraftVersion==d.version && p.publishedAt==request.time
        && r.input=={'displayName':p.displayName,'avatarKey':p.avatarKey,'regionCode':p.regionCode,'bio':p.bio};
    }
    function profileHide(uid,op){
      let n=getAfter(/databases/$(database)/documents/publicProfileControls/$(uid)).data;
      let r=getAfter(/databases/$(database)/documents/users/$(uid)/profileOperations/$(op)).data;
      let prior=exists(/databases/$(database)/documents/publicProfileControls/$(uid))?get(/databases/$(database)/documents/publicProfileControls/$(uid)).data.version:0;
      return profileOwner(uid) && n.visibility=='hidden' && n.lastOperationId==op && n.version==prior+1 && n.updatedAt==request.time
        && !exists(/databases/$(database)/documents/users/$(uid)/profileOperations/$(op)) && r.ownerUid==uid && r.operationId==op && r.command=='hide'
        && r.base=={'draft':0,'control':prior,'publication':0,'moderation':0} && r.result=={'control':prior+1,'publication':0}
        && r.input=={'visibility':'hidden'} && r.consent==false && r.committedAt==request.time;
    }
    match /publicProfileControls/{uid} {
      allow get: if self(uid);
      allow create: if profileOwner(uid) && controlShape(request.resource.data,uid) && ownerVersion(request.resource.data,uid)
        && request.resource.data.version==1 && (request.resource.data.visibility=='hidden' || profilePublication(uid,request.resource.data.lastOperationId));
      allow update: if profileOwner(uid) && controlShape(request.resource.data,uid) && ownerVersion(request.resource.data,uid) && nextVersion()
        && (request.resource.data.visibility=='hidden'?profileHide(uid,request.resource.data.lastOperationId):profilePublication(uid,request.resource.data.lastOperationId));
      allow list,delete: if false;
    }
    match /publicProfiles/{uid} {
      allow get: if (!exists(/databases/$(database)/documents/publicProfiles/$(uid)) && self(uid))
        || (request.auth!=null && publicShape(resource.data,uid) && (self(uid) || visible(uid)));
      allow create,update: if self(uid) && publicShape(request.resource.data,uid)
        && profilePublication(uid,getAfter(/databases/$(database)/documents/publicProfileControls/$(uid)).data.lastOperationId);
      allow list,delete: if false;
    }
    match /users/{uid}/profileOperations/{op} {
      allow get: if self(uid);
      allow list: if self(uid) && request.query.limit!=null && request.query.limit<=20;
      allow create: if self(uid) && validId(op) && request.resource.data.keys().size()==9
        && request.resource.data.keys().hasOnly(['schemaVersion','ownerUid','operationId','command','base','result','input','consent','committedAt'])
        && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion==1 && request.resource.data.ownerUid==uid && request.resource.data.operationId==op
        && request.resource.data.base.keys().size()==4 && request.resource.data.base.keys().hasOnly(['draft','control','publication','moderation'])
        && (request.resource.data.command=='hide'?profileHide(uid,op):profilePublication(uid,op));
      allow update,delete: if false;
    }
    match /users/{uid}/profileReviews/{reviewId} {
      allow get: if self(uid);
      allow list: if self(uid) && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 20;
      allow write: if false;
    }
    match /system/config {
      // Public config is safe only if the operator document matches this allowlist.
      allow get: if resource.data.keys().hasOnly(['schemaVersion', 'environmentLabel', 'featureMode', 'updatedAt'])
        && resource.data.keys().hasAll(['schemaVersion', 'environmentLabel', 'featureMode', 'updatedAt'])
        && resource.data.schemaVersion is int && resource.data.schemaVersion == 1
        && resource.data.environmentLabel is string && resource.data.environmentLabel.size() > 0
        && resource.data.environmentLabel.size() <= 40
        && resource.data.featureMode == 'course_demo' && resource.data.updatedAt is timestamp;
      allow list, write: if false;
    }
    match /securitySubjects/{uid} {
      allow get: if self(uid);
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if self(uid);
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['uid', 'schemaVersion', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'schemaVersion', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }
    // F06: seven-record registration and command receipts are linked with getAfter.
    function memberReady(uid) {
      let shell = get(/databases/$(database)/documents/users/$(uid)).data;
      return self(uid) && request.auth.token.email_verified == true
        && shell.keys().hasOnly(['uid','schemaVersion','createdAt']) && shell.uid == uid && shell.schemaVersion == 1
        && get(/databases/$(database)/documents/securitySubjects/$(uid)).data.status == 'active';
    }
    function bounded(s, min, max, bytes) {
      return s is string && s.size() >= min && s.size() <= max && s.toUtf8().size() <= bytes
        && (s == '' || s.matches('(?s).*[^\\s\\x00-\\x1f\\x7f].*'));
    }
    function petIdentity(d) {
      return d.keys().hasOnly(['displayName','species','breed','sex','ageMonths','ageObservedAt','marks','marksUnknown','illustrationKey'])
        && d.keys().hasAll(['displayName','species','breed','sex','ageMonths','ageObservedAt','marks','marksUnknown','illustrationKey'])
        && bounded(d.displayName,0,80,320) && bounded(d.species,1,40,160) && bounded(d.breed,0,80,320)
        && d.sex in ['unknown','female','male']
        && ((d.ageMonths == null && d.ageObservedAt == null) || (d.ageMonths is int && d.ageMonths >= 0 && d.ageMonths <= 1200 && d.ageObservedAt is timestamp && d.ageObservedAt <= request.time))
        && d.marksUnknown is bool && bounded(d.marks,0,500,2000)
        && ((d.marksUnknown && d.marks == '') || (!d.marksUnknown && d.marks.size() >= 1)) && d.illustrationKey in ['default','cat','dog'];
    }
    function declaration(d) {
      return d.keys().hasOnly(['basis','reportedCare','explanation']) && d.keys().hasAll(['basis','reportedCare','explanation'])
        && d.basis in ['claimed_owner','authorized_caregiver','other_permission'] && d.reportedCare is bool
        && bounded(d.explanation,d.basis == 'claimed_owner' ? 0 : 1,1000,3000);
    }
    function claimInput(c) { return {'basis':c.basis,'reportedCare':c.reportedCare,'explanation':c.explanation}; }
    function petHeader(p,id) {
      return p.keys().hasOnly(['schemaVersion','petId','registrarUid','editorUid','identityVersion','currentRevisionId','custodyVersion','lifecycle','createdAt','updatedAt','lastOperationId'])
        && p.keys().hasAll(['schemaVersion','petId','registrarUid','editorUid','identityVersion','currentRevisionId','custodyVersion','lifecycle','createdAt','updatedAt','lastOperationId'])
        && p.schemaVersion is int && p.schemaVersion == 1 && p.petId == id && validId(id)
        && p.registrarUid is string && p.editorUid is string && p.identityVersion is int && p.identityVersion >= 1
        && p.custodyVersion is int && p.custodyVersion >= 0 && p.lifecycle in ['active','archived'] && validId(p.currentRevisionId)
        && validId(p.lastOperationId) && p.createdAt is timestamp && p.updatedAt is timestamp;
    }
    function petEditor(id) {return request.auth != null && get(/databases/$(database)/documents/pets/$(id)).data.editorUid == request.auth.uid;}
    function petReceipt(r,uid,id) {
      return r.keys().hasOnly(['schemaVersion','ownerUid','operationId','petId','type','role','baseIdentityVersion','baseClaimVersion','baseAuthorityVersion','result','input','status','recordedAt'])
        && r.keys().hasAll(['schemaVersion','ownerUid','operationId','petId','type','role','baseIdentityVersion','baseClaimVersion','baseAuthorityVersion','result','input','status','recordedAt'])
        && r.schemaVersion is int && r.schemaVersion == 1 && r.ownerUid == uid && r.operationId == id && validId(id) && validId(r.petId)
        && r.type in ['register_pet','revise_identity','submit_claim','revise_claim','withdraw_claim','suspend_offering','submit_challenge']
        && r.role in ['registrar','editor','claimant','offer_actor','reporter']
        && r.baseIdentityVersion is int && r.baseIdentityVersion >= 0 && r.baseClaimVersion is int && r.baseClaimVersion >= 0 && r.baseAuthorityVersion is int && r.baseAuthorityVersion >= 0
        && r.result.keys().hasOnly(['identityVersion','claimVersion','authorityVersion']) && r.result.keys().hasAll(['identityVersion','claimVersion','authorityVersion'])
        && r.result.identityVersion is int && r.result.identityVersion >= 0 && r.result.claimVersion is int && r.result.claimVersion >= 0 && r.result.authorityVersion is int && r.result.authorityVersion >= 0
        && r.input is map && r.status == 'committed' && r.recordedAt == request.time;
    }
    function petRegistration(id,uid) {
      let p=getAfter(/databases/$(database)/documents/pets/$(id)).data;
      let r=getAfter(/databases/$(database)/documents/users/$(uid)/petReceipts/$(p.lastOperationId)).data;
      return !exists(/databases/$(database)/documents/pets/$(id)) && memberReady(uid)
        && p.registrarUid == uid && p.editorUid == uid && p.createdAt == request.time && p.updatedAt == request.time
        && p.identityVersion == 1 && p.currentRevisionId == p.lastOperationId
        && r.type == 'register_pet' && r.ownerUid == uid && r.petId == id && r.operationId == p.lastOperationId && r.recordedAt == request.time;
    }
    function registrationLinks(id,uid) {
      let p=getAfter(/databases/$(database)/documents/pets/$(id)).data;
      let revision=getAfter(/databases/$(database)/documents/pets/$(id)/identityRevisions/$(p.currentRevisionId)).data;
      let c=getAfter(/databases/$(database)/documents/pets/$(id)/claims/$(uid)).data;
      let a=getAfter(/databases/$(database)/documents/petOfferAuthorities/$(id)).data;
      let slot=getAfter(/databases/$(database)/documents/petListingSlots/$(id)).data;
      let gate=getAfter(/databases/$(database)/documents/petActivityGates/$(id)).data;
      let r=getAfter(/databases/$(database)/documents/users/$(uid)/petReceipts/$(p.lastOperationId)).data;
      return !exists(/databases/$(database)/documents/pets/$(id)) && memberReady(uid)
        && p.registrarUid == uid && p.editorUid == uid && p.identityVersion == 1 && p.custodyVersion == 0 && p.lifecycle == 'active'
        && p.createdAt == request.time && p.updatedAt == request.time && p.currentRevisionId == p.lastOperationId
        && revision.actorUid == uid && revision.version == 1 && revision.operationId == p.lastOperationId && revision.createdAt == request.time
        && c.claimantUid == uid && c.claimVersion == 1 && c.identityVersion == 1 && c.reviewState == 'draft' && c.submittedRevisionId == null && c.submittedAt == null
        && c.createdAt == request.time && c.updatedAt == request.time && c.lastOperationId == p.lastOperationId
        && a.offerUid == null && a.claimUid == uid && a.claimVersion == 1 && a.identityVersion == 1 && a.authorityVersion == 0 && a.status == 'blocked' && a.hold == 'clear' && a.decisionId == null && a.custodyVersion == 0 && a.updatedAt == request.time && a.lastOperationId == p.lastOperationId
        && slot.activeListingId == null && slot.slotVersion == 0 && slot.updatedAt == request.time
        && gate.state == 'none' && gate.activeReservationId == null && gate.activePlacementId == null && gate.gateVersion == 0 && gate.custodyVersion == 0 && gate.updatedAt == request.time
        && r.operationId == p.lastOperationId && r.recordedAt == request.time && r.type == 'register_pet' && r.role == 'registrar' && r.petId == id
        && r.baseIdentityVersion == 0 && r.baseClaimVersion == 0 && r.baseAuthorityVersion == 0
        && r.result == {'identityVersion':1,'claimVersion':1,'authorityVersion':0}
        && r.input.keys().hasOnly(['identity','claim']) && r.input.keys().hasAll(['identity','claim']) && r.input.identity == revision.identity && r.input.claim == claimInput(c);
    }
    function identityChange(id,uid) {
      let old=get(/databases/$(database)/documents/pets/$(id)).data;
      let p=getAfter(/databases/$(database)/documents/pets/$(id)).data;
      let revision=getAfter(/databases/$(database)/documents/pets/$(id)/identityRevisions/$(p.currentRevisionId)).data;
      let r=getAfter(/databases/$(database)/documents/users/$(uid)/petReceipts/$(p.lastOperationId)).data;
      let claim=get(/databases/$(database)/documents/pets/$(id)/claims/$(uid)).data;
      let authority=get(/databases/$(database)/documents/petOfferAuthorities/$(id)).data;
      return memberReady(uid) && old.editorUid == uid && old.lifecycle == 'active'
        && p.diff(old).affectedKeys().hasOnly(['identityVersion','currentRevisionId','updatedAt','lastOperationId'])
        && p.identityVersion == old.identityVersion + 1 && p.currentRevisionId == p.lastOperationId && p.updatedAt == request.time
        && p.lastOperationId != old.lastOperationId && revision.version == p.identityVersion && revision.operationId == p.lastOperationId && revision.actorUid == uid && revision.createdAt == request.time
        && r.operationId == p.lastOperationId && r.recordedAt == request.time && r.type == 'revise_identity' && r.role == 'editor' && r.petId == id && r.baseIdentityVersion == old.identityVersion
        && r.baseClaimVersion == claim.claimVersion && r.baseAuthorityVersion == authority.authorityVersion
        && r.result == {'identityVersion':p.identityVersion,'claimVersion':claim.claimVersion,'authorityVersion':authority.authorityVersion}
        && r.input.keys().hasOnly(['identity']) && r.input.keys().hasAll(['identity']) && r.input.identity == revision.identity;
    }
    function identityLink(id,uid,op) {
      let old=get(/databases/$(database)/documents/pets/$(id)).data;
      let p=getAfter(/databases/$(database)/documents/pets/$(id)).data;
      return self(uid) && old.editorUid == uid && p.identityVersion == old.identityVersion + 1 && p.lastOperationId == op && p.currentRevisionId == op && p.updatedAt == request.time;
    }
    function claimLink(id,uid,op) {
      let old=get(/databases/$(database)/documents/pets/$(id)/claims/$(uid)).data;
      let c=getAfter(/databases/$(database)/documents/pets/$(id)/claims/$(uid)).data;
      return self(uid) && old.claimantUid == uid && c.claimVersion == old.claimVersion + 1 && c.lastOperationId == op && c.updatedAt == request.time;
    }
    function claimAuthorityLink(id,uid) {
      let a=get(/databases/$(database)/documents/petOfferAuthorities/$(id)).data;
      let next=getAfter(/databases/$(database)/documents/petOfferAuthorities/$(id)).data;
      let c=getAfter(/databases/$(database)/documents/pets/$(id)/claims/$(uid)).data;
      return claimLink(id,uid,next.lastOperationId) && c.reviewState in ['draft','withdrawn'] && a.claimUid == uid && a.status == 'enabled'
        && next.status == 'suspended' && next.authorityVersion == a.authorityVersion + 1 && next.updatedAt == request.time
        && next.diff(a).affectedKeys().hasOnly(['status','authorityVersion','updatedAt','lastOperationId']);
    }
    function claimShape(c,id,uid) {
      return c.keys().hasOnly(['schemaVersion','petId','claimantUid','claimVersion','identityVersion','basis','reportedCare','explanation','reviewState','submittedRevisionId','submittedAt','createdAt','updatedAt','lastOperationId'])
        && c.keys().hasAll(['schemaVersion','petId','claimantUid','claimVersion','identityVersion','basis','reportedCare','explanation','reviewState','submittedRevisionId','submittedAt','createdAt','updatedAt','lastOperationId'])
        && c.schemaVersion is int && c.schemaVersion == 1 && c.petId == id && c.claimantUid == uid && c.claimVersion is int && c.claimVersion >= 1 && c.identityVersion is int && c.identityVersion >= 1
        && declaration(claimInput(c)) && c.reviewState in ['draft','submitted','needs_information','accepted_for_demo','rejected','withdrawn']
        && (c.submittedRevisionId == null || validId(c.submittedRevisionId)) && (c.submittedAt == null || c.submittedAt is timestamp)
        && c.createdAt is timestamp && c.updatedAt is timestamp && validId(c.lastOperationId);
    }
    function authorityShape(a,id) {
      return a.keys().hasOnly(['schemaVersion','petId','offerUid','claimUid','claimVersion','identityVersion','authorityVersion','status','hold','decisionId','custodyVersion','updatedAt','lastOperationId'])
        && a.keys().hasAll(['schemaVersion','petId','offerUid','claimUid','claimVersion','identityVersion','authorityVersion','status','hold','decisionId','custodyVersion','updatedAt','lastOperationId'])
