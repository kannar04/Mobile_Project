<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="?attr/colorSurface">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.gmail.manhle240406.project.auth.BoundedFormLayout
            android:id="@+id/auth_form" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:orientation="vertical" android:padding="24dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/auth_back"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp"
                android:text="@string/auth_back" />
            <TextView android:id="@+id/auth_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="32dp"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" android:accessibilityHeading="true"
                android:textColor="?attr/colorOnSurface" android:text="@string/auth_signin_title" />
            <TextView android:id="@+id/auth_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/auth_signin_body" />
            <LinearLayout android:id="@+id/auth_credentials" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/auth_email_layout"
                    style="@style/AuthField" android:hint="@string/auth_email">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/auth_email"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="56dp" android:inputType="textEmailAddress" android:singleLine="true"
                        android:autofillHints="username" android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/auth_password_layout"
                    style="@style/AuthField" android:hint="@string/auth_password" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/auth_password"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false"
                        android:singleLine="true" android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/auth_confirm_layout"
                    style="@style/AuthField" android:hint="@string/auth_confirm" app:endIconMode="password_toggle"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/auth_confirm"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:inputType="textPassword" android:autofillHints="newPassword" android:saveEnabled="false"
                        android:singleLine="true" android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView android:id="@+id/auth_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/auth_progress"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:indeterminate="true" android:visibility="gone" android:importantForAccessibility="no" />
            <com.google.android.material.button.MaterialButton android:id="@+id/auth_submit" style="@style/AuthButton"
                android:text="@string/auth_signin" />
            <com.google.android.material.button.MaterialButton android:id="@+id/auth_google" style="@style/AuthTonalButton"
                android:text="@string/auth_google" />
            <TextView android:id="@+id/auth_google_help" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyMedium" android:text="@string/auth_google_unavailable" />
            <com.google.android.material.button.MaterialButton android:id="@+id/auth_switch" style="@style/AuthTonalButton"
                android:text="@string/auth_register" />
            <LinearLayout android:id="@+id/auth_account_actions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_verify" style="@style/AuthButton"
                    android:text="@string/auth_verify" />
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_refresh" style="@style/AuthTonalButton"
                    android:text="@string/auth_refresh" />
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_retry_setup" style="@style/AuthTonalButton"
                    android:text="@string/auth_retry_setup" />
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_profile" style="@style/AuthTonalButton"
                    android:text="@string/profile_title" />
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_pets" style="@style/AuthTonalButton" android:text="@string/pet_title" />
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_listings" style="@style/AuthTonalButton" android:text="@string/listing_title" />
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_community" style="@style/AuthTonalButton" android:text="@string/community_title" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/auth_proof_layout"
                    style="@style/AuthField" android:hint="@string/auth_proof" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/auth_proof"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false"
                        android:singleLine="true" android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/auth_link" style="@style/AuthTonalButton"
                    android:text="@string/auth_google_link" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/auth_logout" style="@style/AuthTonalButton"
                android:text="@string/auth_logout" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/auth_visitor" style="@style/AuthTonalButton"
                android:text="@string/auth_visitor" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:text="@string/auth_disclosure" android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </com.gmail.manhle240406.project.auth.BoundedFormLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
